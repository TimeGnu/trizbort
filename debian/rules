#!/usr/bin/make -f
# Build the Qt/C++ Trizbort (the CMake project lives in qt/).

include /usr/share/dpkg/pkg-info.mk

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --sourcedirectory=qt --buildsystem=cmake

# Bake the changelog's upstream version into the binary, so the About box
# matches the package version and the build does not rely on git being present.
override_dh_auto_configure:
	dh_auto_configure -- -DTRIZBORT_VERSION=$(DEB_VERSION_UPSTREAM)

# The upstream test suite (qt/tests/*.sh) needs a Qt platform plugin and is run
# separately; there are no CTest tests to run here.
override_dh_auto_test:

#include "verblib.g" ! grammar must come first

#include "hugolib.h"

routine init
{
	cls
	verbosity = 2
	counter = -1
	STATUSTYPE = 1 !1 = score / turns, 2 = time, 3 = moves: score:
	player = you
	Font(BOLD_ON)
	"Zork_770614"
	Font(BOLD_OFF)
	"by A Trizbort User"
	location = WestofHouse
	MovePlayer(location)
}


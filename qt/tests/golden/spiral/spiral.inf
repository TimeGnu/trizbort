Constant Story "spiral";
Constant Headline "^By J. Lautzenheiser^^^";

Include "Parser";
Include "VerbLib";

Class Both;
Class Helen;
Class Ross;

Helen  Mountainside "Mountainside"
  with  description
            "",
        s_to FootoftheMountainS,
   has  light;

Helen  FootoftheMountainS "Foot of the Mountain S"
  with  description
            "",
        n_to Mountainside,
        e_to FootoftheMountainE,
        w_to FootoftheMountainW,
        se_to ChurchIsle,

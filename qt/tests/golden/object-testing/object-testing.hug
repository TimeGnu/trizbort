routine init
{
	cls
	verbosity = 2
	counter = -1
	STATUSTYPE = 1 !1 = score / turns, 2 = time, 3 = moves: score:
	player = you
	Font(BOLD_ON)
	"object-testing"
	Font(BOLD_OFF)
	"by A Trizbort User"
	location = TestRoom
	MovePlayer(location)
}

